; harness. 120 bpm 4/4: 1 beat = 0.5 s, 1 bar = 2.0 s; :dur 4bar = 8.0 s
; (16 beats = 2882880 ticks). intro spans [0b,6b) = [0.0,3.0) s; drop spans
; [4b,12b) = [2.0,6.0) s; they overlap on [4b,6b) = [2.0,3.0) s. Registry 1
; on pulse pins that a scened write carries its bus flag through.
(target level :registry 0)   ; id 0 — driven by BOTH scenes (the handoff)
(target sweep :registry 0)   ; id 1 — intro's scene-phase expr
(target pulse :registry 1)   ; id 2 — drop's scene-beat expr
(times
  "0000000000000000" ; 0.0 s — beat 0: intro only, scene start (level 0.1, phase 0)
  "3FF0000000000000" ; 1.0 s — beat 2: intro only, mid (scene-phase = 1/3, non-dyadic)
  "4000000000000000" ; 2.0 s — beat 4: overlap opens; drop's start landing wins the handoff
  "4004000000000000" ; 2.5 s — beat 5: overlap, both scenes mid-window
  "4010000000000000" ; 4.0 s — beat 8: intro ended, drop only
  "4018000000000000" ; 6.0 s — beat 12: drop's exclusive end — no scene active (empty writes)
  "4020000000000000" ; 8.0 s — exactly :dur: wraps to tick 0, re-enters intro at its start
  "4022000000000000" ; 9.0 s — wraps to 1.0 s (beat 2): loop re-entry mid-intro
)
