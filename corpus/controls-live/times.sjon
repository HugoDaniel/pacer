; controls-live harness. depth = index 0, sway = index 1 (the document
; controls, in text order); dynamic slots start at index 2. `sway` is
; env-only; `lift` (id 2) has no track or pin and only writes while a
; register-control slot holds it. Directives execute in document order
; and each echoes its acceptance, so rejection semantics are pinned.
(target radius :registry 0)   ; id 0 — keyed track
(target blend :registry 0)    ; id 1 — expr track (depth * sway)
(target lift :registry 0)     ; id 2 — unpinned, driven by a lifted slot
(target gain :registry 1)     ; id 3 — depth's write target

(times "0000000000000000")    ; baseline: radius 0, blend 0.125, gain 0.25

(set-control :index 0 :value ["3F000000" "00000000" "00000000" "00000000"])  ; depth = 0.5
(times "0000000000000000")    ; blend 0.25, gain 0.5

(set-control :index 0 :value ["7FC00000" "00000000" "00000000" "00000000"])  ; NaN → rejected
(clear-control :index 0)      ; depth back to the document 0.25
(times "0000000000000000")    ; blend 0.125, gain 0.25 again

(set-bpm :bpm "4059000000000000")   ; 100 bpm — accepted
(set-bpm :bpm "7FF8000000000000")   ; NaN — rejected
(times "3FF0000000000000")    ; 1.0 s at 100 bpm — radius mid-segment, rescaled

(register-control :target-id 2 :registry 0 :ncomp 1)  ; lift → slot 2
(set-control :index 2 :value ["3F800000" "00000000" "00000000" "00000000"])  ; lift = 1.0 held
(times "0000000000000000")    ; lift now writes 1.0
(clear-control :index 2)      ; release the lift
(times "0000000000000000")    ; lift silent again
