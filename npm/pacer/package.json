{
  "name": "@mr_hugo/pacer",
  "version": "0.1.0",
  "type": "module",
  "description": "JS glue for pacer.wasm — deterministic animation driver conducted by an SJON score",
  "keywords": [
    "animation",
    "deterministic",
    "wasm",
    "webassembly",
    "sjon",
    "easing",
    "timeline",
    "audio"
  ],
  "author": "Hugo Daniel <mail@hugodaniel.pt>",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoDaniel/pacer.git",
    "directory": "npm/pacer"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./audio": {
      "types": "./types/audio.d.ts",
      "default": "./src/audio.js"
    },
    "./host-check": {
      "types": "./types/host-check.d.ts",
      "default": "./src/host-check.js"
    },
    "./clock": {
      "types": "./types/clock.d.ts",
      "default": "./src/clock.js"
    },
    "./route": {
      "types": "./types/route.d.ts",
      "default": "./src/route.js"
    },
    "./rt": {
      "types": "./types/rt.d.ts",
      "default": "./src/rt.js"
    },
    "./pacer.wasm": "./pacer.wasm",
    "./pacer-rt.wasm": "./pacer-rt.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "pacer.wasm",
    "pacer-rt.wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "cd ../.. && zig build wasm",
    "build:wasm-copy": "node -e \"require('node:fs').copyFileSync('../../zig-out/bin/pacer.wasm','pacer.wasm')\"",
    "build:wasm-rt": "cd ../.. && zig build wasm-rt",
    "build:wasm-rt-copy": "node -e \"require('node:fs').copyFileSync('../../zig-out/bin/pacer-rt.wasm','pacer-rt.wasm')\"",
    "build:rt-fixture": "cd ../.. && zig build run -- pack tools/testdata/pacb/full-small.score.sjon --out npm/pacer/test/rt-fixture.pacb",
    "build:cli": "cd ../.. && zig build cli",
    "gen:rt-corpus-fixtures": "node tools/generate-rt-fixtures.js",
    "build:types": "tsc",
    "build": "npm run build:wasm && npm run build:wasm-rt && npm run build:wasm-copy && npm run build:wasm-rt-copy && npm run build:types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test tools browser playwright.config.js",
    "format": "biome check --write src test browser playwright.config.js",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('types',{recursive:true,force:true});fs.rmSync('pacer.wasm',{force:true});fs.rmSync('pacer-rt.wasm',{force:true});fs.rmSync('test/rt-fixture.pacb',{force:true})\"",
    "pretest": "npm run build:wasm && npm run build:wasm-rt && npm run build:wasm-rt-copy && npm run build:rt-fixture && npm run build:cli && npm run gen:rt-corpus-fixtures",
    "g5:prepare": "node browser/prepare.mjs",
    "g5:serve": "node browser/server.mjs",
    "g5:test": "node --test browser/g5/server-spec.mjs browser/g5/prepare-spec.mjs",
    "test:browser": "node browser/g5/playwright.mjs",
    "test": "node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
