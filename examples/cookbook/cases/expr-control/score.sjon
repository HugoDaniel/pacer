; expr-control: depth is a targeted slider (its document value writes `gain`
; every frame and binds as `depth`); sway is an env-only knob. `spike`
; divides by zero at exactly beat 1, which is a per-frame omission, not a
; load failure. Control writes land after track writes in `order`.
(transport :bpm 120 :meter [4 4])

(control :id depth :target gain :min 0 :max 1 :value 0.25)
(control :id sway :value 0.5)

(track :target wave
  :expr (+ 0.5 (* 0.5 (sin (* (tau) beat)))))

(track :target spike
  :expr (/ 1 (- beat 1)))

(track :target mod
  :expr (* depth sway))
